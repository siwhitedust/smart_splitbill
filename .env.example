# ==============================================================================
# SMART SPLITBILL - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilai-nilainya:
# cp .env.example .env
# ==============================================================================

# Mode Aplikasi (True untuk lokal development, False untuk production)
DJANGO_DEBUG=True

# Port default aplikasi (contoh: 8080, 8000, 5000)
PORT=8000

# Kunci Rahasia Django (Ganti dengan string acak panjang di production)
DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak-dan-aman-untuk-production

# Host yang diizinkan (pisahkan dengan koma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CSRF Trusted Origins (pisahkan dengan koma)
# Diperlukan saat mengakses via Cloudflare Tunnel (trycloudflare.com) atau HTTPS kustom
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.trycloudflare.com

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI (OCR STRUK BELANJA)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_masukkan_api_key_gemini_anda_di_sini

# Model Utama Gemini yang digunakan (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model Cadangan otomatis jika model utama mengalami kuota habis / rate limit
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# ------------------------------------------------------------------------------
# FITUR & KEAMANAN SPLITBILL
# ------------------------------------------------------------------------------
# Path URL kustom untuk Dashboard Admin Smart Splitbill
ADMIN_URL_PATH=portal-rahasia-admin

# Masa berlaku penyimpanan tagihan dalam detik (Default: 600 detik = 10 menit)
SPLITBILL_TTL_SECONDS=600

# Kuota maksimal analisis struk OCR per hari (per IP + Session)
RATE_LIMIT_DAILY_MAX=5

# Opsional: Redis Cache URL untuk production (kosongkan untuk menggunakan LocMemCache)
# DJANGO_REDIS_URL=redis://127.0.0.1:6379/1
