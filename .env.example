# Smart Splitbill - Environment Configuration

# Mode Aplikasi (True untuk lokal, False untuk Production)
DJANGO_DEBUG=True

# Port default aplikasi (contoh: 8080, 8000, 5000)
PORT=8080

# Kunci Rahasia Django (Ganti dengan string acak panjang di production)
DJANGO_SECRET_KEY=ganti-dengan-secret-key-aman-dan-rahasia-anda

# Host yang diizinkan (pisahkan dengan koma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Masa berlaku penyimpanan tagihan dalam detik (Default: 600 detik / 10 menit)
SPLITBILL_TTL_SECONDS=600

# Kuota analisis struk OCR harian per IP + Session
RATE_LIMIT_DAILY_MAX=5

# Opsional: Redis Cache untuk production (kosongkan untuk menggunakan LocMemCache lokal)
# DJANGO_REDIS_URL=redis://127.0.0.1:6379/1

# Path kustom binary Tesseract (opsional)
# TESSERACT_CMD=/usr/bin/tesseract

